{
  "name": "wxt-svelte-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "node --experimental-strip-types --test src/lib/message-history.test.ts src/lib/i18n/resolve-locale.test.ts src/lib/message-text-policy.test.ts",
    "check:locales": "node scripts/validate-locale-keys.js",
    "postinstall": "wxt prepare && node scripts/patch-spacetimedb.js && node scripts/patch-spacetimedb-codegen.js",
    "codegen:stdb": "spacetime generate --lang typescript --out-dir src/lib/spacetimedb --module-path ../server && node scripts/patch-spacetimedb-codegen.js"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.4",
    "patch-package": "^8.0.1",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "spacetimedb": "^2.13.0"
  }
}
